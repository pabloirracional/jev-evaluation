# Copy this file to .env and fill in your own values. .env is git-ignored; never commit it.

# Vercel AI Gateway key (vck_...). Jev is reached through the gateway.
TYPESAFE_API_KEY=

# Vercel AI Gateway endpoint for Jev
JEV_URL=https://ai-gateway.vercel.sh/typesafe/v1/systemone

# Requests per minute. The Vercel AI Gateway allows 30/min; 28 leaves a margin.
JEV_RATE_PER_MIN=28
