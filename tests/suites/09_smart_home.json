  "what_it_tests": "Turn a sentence into action + room, like a function call. Includes sentences with no command and sentences with negation.",
  "questions": {
    "action": {
      "type": "choice",
      "instructions": "Which action the person wants the house to perform now",
      "criteria": {
        "lights_on": {
          "what": "Turn lights on"
        },
        "lights_off": {
          "what": "Turn lights off"
        },
        "adjust_temperature": {
          "what": "Change the air conditioning or heating"
        },
        "play_music": {
          "what": "Play music"
        },
        "lock_door": {
          "what": "Close or lock a door or gate"
        },
        "none": {
          "what": "No action should be performed now"
        }
      }
    },
    "room": {
      "type": "choice",
      "instructions": "In which room the action should happen",
      "criteria": {
        "living_room": null,
        "kitchen": null,
        "bedroom": null,
        "garage": null,
        "whole_house": {
          "what": "All rooms"
        },
        "not_specified": {
          "what": "The sentence doesn't say the room"
        }
      }
    }
  },
